# ---------------------------------------------------------------------------
# Скопируйте в .env и при необходимости поправьте. docker-compose.yml читает
# этот файл автоматически; значения по умолчанию рассчитаны на локальный запуск.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen
POSTGRES_DB=kitchen
POSTGRES_PORT=5432

# DSN, который видят контейнеры api/migrate (хост = имя сервиса в compose).
DATABASE_URL=postgres://kitchen:kitchen@postgres:5432/kitchen?sslmode=disable

# DSN для запуска с хоста (make test-integration, migrate вручную).
DATABASE_URL_HOST=postgres://kitchen:kitchen@localhost:5432/kitchen?sslmode=disable

# --- API --------------------------------------------------------------------
API_PORT=8080
LOG_LEVEL=info
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s

# Пул соединений с БД.
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Транзакционный outbox: как часто опрашивать таблицу и сколько событий за раз.
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_HTTP_TIMEOUT=5s

# Reaper: авто-отмена «зависших» заказов и уборка ключей идемпотентности.
REAPER_INTERVAL=30s
ORDER_ACCEPT_TIMEOUT=5m

# Сколько живёт сохранённый ответ по Idempotency-Key.
IDEMPOTENCY_TTL=24h

# --- Restaurant simulator ---------------------------------------------------
SIM_PORT=8081
SIM_API_BASE_URL=http://api:8080
SIM_PARTNER_TOKEN=dev-partner-token
SIM_RESTAURANT_SLUG=pizza-avito

# Автоматически принимать заказы и вести их по конвейеру ACCEPTED→COOKING→READY.
SIM_AUTO_ACCEPT=true
SIM_ACCEPT_DELAY_MS=1000
SIM_COOKING_TIME_MS=3000
SIM_READY_DELAY_MS=2000

# Аварийный режим: отклонять все входящие заказы (имеет приоритет над AUTO_ACCEPT).
SIM_REJECT_ALL=false

# Синхронизировать эталонное меню в платформу при старте.
SIM_SYNC_MENU_ON_START=true
